// IUSI LMS — database schema.
// Conventions: cuid ids, createdAt/updatedAt everywhere, soft delete via deletedAt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (Neon / Vercel Postgres)
  directUrl = env("DIRECT_URL") // direct connection, used by migrations
}

// ───────────── Enums ─────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Shift {
  KUNDUZGI // day shift
  KECHKI // evening shift
}

enum Language {
  UZ
  RU
  EN
}

enum LessonType {
  LECTURE // LEKSIYA
  SEMINAR // SEMENAR
  PRACTICE // AMALIYOT
}

enum TeacherRole {
  LECTURE
  PRACTICE
}

enum EnrollmentStatus {
  ACTIVE
  ACADEMIC_LEAVE
  EXPELLED
  GRADUATED
}

enum ScheduleChangeType {
  MOVED
  CANCELLED
}

enum MaterialType {
  FILE
  LINK
  PAGE
  VIDEO
}

enum SubmissionType {
  FILE
  TEXT
  BOTH
}

enum GradeCategory {
  CURRENT // joriy
  MIDTERM // oraliq (ON)
  FINAL // yakuniy (YN)
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum AnnouncementScope {
  ALL
  GROUPS
}

// ───────────── Users ─────────────

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String? // null = account cannot log in yet
  fullName           String
  role               Role
  phone              String?
  avatarUrl          String?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  teachingCourses   CourseTeacher[]
  enrollments       Enrollment[]
  scheduleSlots     ScheduleSlot[]
  uploadedMaterials Material[]
  submissions       Submission[]
  gradesGiven       Grade[]
  attendance        Attendance[]
  announcements     Announcement[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  passwordResets    PasswordResetToken[]

  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])
}

// ───────────── Organisation ─────────────

model Faculty {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  programs Program[]
}

model Program {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  facultyId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  faculty Faculty @relation(fields: [facultyId], references: [id])
  groups  Group[]
}

model Semester {
  id        String    @id @default(cuid())
  name      String
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  groups        Group[]
  courses       Course[]
  scheduleSlots ScheduleSlot[]
}

model Group {
  id         String    @id @default(cuid())
  name       String    @unique // e.g. "26-01 Yuris", "26K-02 Yuris rus"
  programId  String
  semesterId String
  year       Int       @default(1) // study year (kurs)
  shift      Shift
  language   Language  @default(UZ)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  program       Program           @relation(fields: [programId], references: [id])
  semester      Semester          @relation(fields: [semesterId], references: [id])
  courseGroups  CourseGroup[]
  enrollments   Enrollment[]
  scheduleSlots ScheduleSlot[]
  assignments   AssignmentGroup[]
}

model Room {
  id        String    @id @default(cuid())
  name      String    @unique // "210", "Library", "Atrium"
  capacity  Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  scheduleSlots ScheduleSlot[]
}

// Bell schedule: para number → time, per shift.
model LessonPeriod {
  id        String    @id @default(cuid())
  shift     Shift
  number    Int
  startTime String // "10:00"
  endTime   String // "11:20"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  scheduleSlots ScheduleSlot[]

  @@unique([shift, number])
}

// ───────────── Courses ─────────────

model Course {
  id            String    @id @default(cuid())
  name          String
  code          String    @unique
  credits       Int       @default(0)
  language      Language  @default(UZ)
  semesterId    String
  // grade weights in percent; must sum to 100
  weightCurrent Int       @default(40)
  weightMidterm Int       @default(30)
  weightFinal   Int       @default(30)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  semester      Semester        @relation(fields: [semesterId], references: [id])
  teachers      CourseTeacher[]
  groups        CourseGroup[]
  scheduleSlots ScheduleSlot[]
  modules       Module[]
  assignments   Assignment[]

  @@index([semesterId])
}

model CourseTeacher {
  id        String      @id @default(cuid())
  courseId  String
  userId    String
  role      TeacherRole @default(LECTURE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  course Course @relation(fields: [courseId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([courseId, userId, role])
  @@index([userId])
}

model CourseGroup {
  id        String    @id @default(cuid())
  courseId  String
  groupId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  course Course @relation(fields: [courseId], references: [id])
  group  Group  @relation(fields: [groupId], references: [id])

  @@unique([courseId, groupId])
  @@index([groupId])
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  groupId   String
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
  @@index([groupId])
}

// ───────────── Schedule ─────────────

// Weekly template slot, repeats through the semester.
model ScheduleSlot {
  id          String      @id @default(cuid())
  semesterId  String
  courseId    String
  groupId     String
  teacherId   String?
  roomId      String?
  periodId    String
  dayOfWeek   Int // 1 = Monday … 6 = Saturday
  lessonType  LessonType?
  alternating Boolean     @default(false) // "MIGALKA": every other week
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  semester   Semester         @relation(fields: [semesterId], references: [id])
  course     Course           @relation(fields: [courseId], references: [id])
  group      Group            @relation(fields: [groupId], references: [id])
  teacher    User?            @relation(fields: [teacherId], references: [id])
  room       Room?            @relation(fields: [roomId], references: [id])
  period     LessonPeriod     @relation(fields: [periodId], references: [id])
  changes    ScheduleChange[]
  attendance Attendance[]

  @@index([semesterId, groupId])
  @@index([semesterId, teacherId, dayOfWeek, periodId])
  @@index([semesterId, roomId, dayOfWeek, periodId])
}

model ScheduleChange {
  id          String             @id @default(cuid())
  slotId      String
  date        DateTime           @db.Date // the affected occurrence
  type        ScheduleChangeType
  reason      String
  newDate     DateTime?          @db.Date
  newPeriodId String?
  newRoomId   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  slot ScheduleSlot @relation(fields: [slotId], references: [id])

  @@index([slotId, date])
}

// ───────────── Content ─────────────

model Module {
  id        String    @id @default(cuid())
  courseId  String
  title     String
  position  Int       @default(0)
  opensAt   DateTime?
  isHidden  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  course      Course       @relation(fields: [courseId], references: [id])
  materials   Material[]
  assignments Assignment[]

  @@index([courseId])
}

model Material {
  id           String       @id @default(cuid())
  moduleId     String
  type         MaterialType
  title        String
  fileUrl      String? // Vercel Blob URL
  url          String? // external link / YouTube
  body         String? // PAGE content
  sizeBytes    Int?
  mimeType     String?
  uploadedById String
  version      Int          @default(1)
  previousId   String? // previous version of this material
  position     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  module     Module @relation(fields: [moduleId], references: [id])
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([moduleId])
}

// ───────────── Assignments & grading ─────────────

model Assignment {
  id             String         @id @default(cuid())
  courseId       String
  moduleId       String?
  title          String
  description    String?
  attachmentUrl  String?
  maxScore       Int
  category       GradeCategory  @default(CURRENT)
  startsAt       DateTime
  deadline       DateTime
  allowLate      Boolean        @default(false)
  lateDays       Int            @default(0)
  latePenaltyPct Int            @default(0)
  submissionType SubmissionType @default(FILE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  course      Course            @relation(fields: [courseId], references: [id])
  module      Module?           @relation(fields: [moduleId], references: [id])
  groups      AssignmentGroup[]
  submissions Submission[]

  @@index([courseId])
  @@index([deadline])
}

model AssignmentGroup {
  id           String    @id @default(cuid())
  assignmentId String
  groupId      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  group      Group      @relation(fields: [groupId], references: [id])

  @@unique([assignmentId, groupId])
}

model Submission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  text         String?
  fileUrl      String?
  submittedAt  DateTime  @default(now())
  isLate       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])
  grade      Grade?

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model Grade {
  id           String    @id @default(cuid())
  submissionId String    @unique
  score        Float
  comment      String?
  gradedById   String
  gradedAt     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  submission Submission @relation(fields: [submissionId], references: [id])
  gradedBy   User       @relation(fields: [gradedById], references: [id])
}

model Attendance {
  id        String           @id @default(cuid())
  slotId    String
  studentId String
  date      DateTime         @db.Date
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  slot    ScheduleSlot @relation(fields: [slotId], references: [id])
  student User         @relation(fields: [studentId], references: [id])

  @@unique([slotId, studentId, date])
  @@index([studentId])
}

// ───────────── Communication ─────────────

model Announcement {
  id        String            @id @default(cuid())
  authorId  String
  title     String
  body      String
  scope     AnnouncementScope @default(ALL)
  groupIds  String[] // used when scope = GROUPS
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  author User @relation(fields: [authorId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  message   String
  link      String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model AuditLog {
  id        String    @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
}
