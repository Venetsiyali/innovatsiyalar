# PostgreSQL (Vercel: Neon integration sets these automatically)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iusi_lms"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/iusi_lms"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true

# Initial admin (used by prisma/seed.ts)
ADMIN_EMAIL="admin@iusi.uz"
ADMIN_PASSWORD="Admin12345!"

# Vercel Blob (file uploads, stage 3)
BLOB_READ_WRITE_TOKEN=""

# Vercel Cron secret (Settings → Environment Variables)
CRON_SECRET=""
